# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# Build output
dist/

# OS
.DS_Store

# Supabase personal access token, pasted locally. Never committed.
# Broad on purpose: Notepad appends .txt and drops the leading dot, so the
# exact filename cannot be relied on. Anything token-shaped is excluded.
.supabase-token
*supabase-token*
*.token
*access-token*

# Supabase CLI machine-local scratch: linked-project state, version probes and
# a pooler URL. No credentials, but it differs per machine and per login.
supabase/.temp/
